{
  "name": "scoreatlas",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "vars": {
    "ALLOW": "https://scoreatlas.org,https://www.scoreatlas.org"
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "Chat" }]
  },
  "triggers": { "crons": ["*/20 * * * *"] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Chat"] }]
}
